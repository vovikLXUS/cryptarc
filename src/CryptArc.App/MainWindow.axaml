<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CryptArc.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:Class="CryptArc.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="780" MinWidth="900" MinHeight="600"
        Background="{DynamicResource SemiColorBackground1}"
        DragDrop.AllowDrop="True"
        Title="CryptArc" Icon="avares://CryptArc.App/Assets/icon.png">

    <Window.Styles>
        <Style Selector="ListBox.Nav > ListBoxItem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.Nav > ListBoxItem PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Border.Soon">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="264,*">

        <!-- Side menu. Its items are a view concern, so they live here; the view
             model only knows the selected index. -->
        <Border Grid.Column="0" Background="{DynamicResource SemiColorBackground0}"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,1,0"
                Padding="12,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="12,0,0,20">
                    <Image Source="avares://CryptArc.App/Assets/logo.png" Width="28" Height="28" />
                    <TextBlock Text="CryptArc" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <ListBox Classes="Nav" SelectedIndex="{Binding SelectedPageIndex}" Background="Transparent">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource SemiIconSearch}" />
                            <TextBlock Text="Analyse" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource SemiIconHistogram}" />
                            <TextBlock Text="Compare codecs" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource SemiIconLayers}" />
                            <TextBlock Text="Compress" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource SemiIconBeaker}" />
                            <TextBlock Text="Transform lab" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource SemiIconBolt}" />
                            <TextBlock Text="Naive vs optimised" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsEnabled="False">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Classes="Soon"><TextBlock Classes="Hint" Text="soon" /></Border>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource SemiIconLock}" />
                                <TextBlock Text="Encrypted archive" />
                            </StackPanel>
                        </DockPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="28,24">

            <!-- The loaded file, shared by every page. -->
            <Border DockPanel.Dock="Top" Classes="Card" Margin="0,0,0,24">
                <DockPanel>
                    <Button Name="ChooseFileButton" DockPanel.Dock="Right"
                            Classes="Primary" Theme="{DynamicResource SolidButton}"
                            Content="Choose file…" IsEnabled="{Binding !IsBusy}"
                            VerticalAlignment="Center" />
                    <PathIcon DockPanel.Dock="Left" Data="{StaticResource SemiIconFile}"
                              Width="28" Height="28" Margin="0,0,14,0"
                              Foreground="{DynamicResource SemiColorPrimary}" />
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Classes="Hint" Text="{Binding FileSize}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}"
                                         VerticalAlignment="Center" />
                            <TextBlock Classes="Hint" Text="{Binding Status}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TransitioningContentControl Content="{Binding CurrentPage}" />
        </DockPanel>

        <!-- Shown while a file is dragged over the window. It never takes input, so
             the drag events keep reaching the window itself. It carries no text on
             purpose: the picture is enough and needs no translation. -->
        <Border Name="DropOverlay" Grid.ColumnSpan="2" IsVisible="False" IsHitTestVisible="False"
                Background="#CCF8FAFC" Padding="24">
            <Panel>
                <Rectangle RadiusX="16" RadiusY="16" StrokeThickness="2" StrokeDashArray="6,4"
                           Stroke="{DynamicResource SemiColorPrimary}"
                           Fill="{DynamicResource SemiColorPrimaryLight}" Opacity="0.6" />
                <PathIcon Data="{StaticResource SemiIconFile}" Width="72" Height="72"
                          Foreground="{DynamicResource SemiColorPrimary}" />
            </Panel>
        </Border>
    </Grid>
</Window>
