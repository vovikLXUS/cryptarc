<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CryptArc.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
        x:Class="CryptArc.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="820" Height="560"
        Title="CryptArc">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Width" Value="130" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12">
            <Button Name="ChooseFileButton"
                    Content="Choose file…"
                    IsEnabled="{Binding !IsBusy}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.75" />
        </StackPanel>

        <Border DockPanel.Dock="Top" Margin="0,18,0,0" Padding="16"
                CornerRadius="6" BorderThickness="1" BorderBrush="#33888888">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="label" Text="File" />
                    <TextBlock Classes="value" Text="{Binding FileName}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="label" Text="Size" />
                    <TextBlock Classes="value" Text="{Binding FileSize}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="label" Text="CRC-32" />
                    <TextBlock Classes="value" Text="{Binding Checksum}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="label" Text="Entropy" />
                    <TextBlock Classes="value" Text="{Binding Entropy}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="label" Text="Repeat ratio" />
                    <TextBlock Classes="value" Text="{Binding RepeatRatio}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="label" Text="Text ratio" />
                    <TextBlock Classes="value" Text="{Binding TextRatio}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="label" Text="Recommended" />
                    <TextBlock Classes="value" FontWeight="SemiBold" Text="{Binding Recommendation}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Margin="0,20,0,8"
                   FontWeight="SemiBold" Text="Codec comparison" />

        <Grid DockPanel.Dock="Top" ColumnDefinitions="140,120,90,190,90" Margin="4,0,4,6">
            <TextBlock Grid.Column="0" Text="Codec" Opacity="0.6" />
            <TextBlock Grid.Column="1" Text="Compressed" Opacity="0.6" />
            <TextBlock Grid.Column="2" Text="Ratio" Opacity="0.6" />
            <TextBlock Grid.Column="3" Text="Encode / Decode" Opacity="0.6" />
            <TextBlock Grid.Column="4" Text="Status" Opacity="0.6" />
        </Grid>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CodecResult">
                        <Grid ColumnDefinitions="140,120,90,190,90" Margin="4,3">
                            <TextBlock Grid.Column="0" Text="{Binding Codec}" />
                            <TextBlock Grid.Column="1" Classes="value" Text="{Binding SizeText}" />
                            <TextBlock Grid.Column="2" Classes="value" Text="{Binding RatioText}" />
                            <TextBlock Grid.Column="3" Classes="value" Text="{Binding SpeedText}" />
                            <TextBlock Grid.Column="4" Text="{Binding StatusText}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
