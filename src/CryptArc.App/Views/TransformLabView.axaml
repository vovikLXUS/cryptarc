<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CryptArc.App.Localization"
             xmlns:vm="using:CryptArc.App.ViewModels"
             xmlns:svc="using:CryptArc.App.Services"
             x:Class="CryptArc.App.Views.TransformLabView"
             x:DataType="vm:TransformLabPageViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.Code">
            <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="SelectableTextBlock.Code">
            <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.Chip">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Classes="PageTitle" Text="{loc:T Lab.Title}" />
                <TextBlock Classes="Secondary"
                           Text="{loc:T Lab.Subtitle}" />
            </StackPanel>

            <!-- Input -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Classes="Hint" VerticalAlignment="Center" Text="{Binding InputNote}" />
                        <TextBlock Classes="CardTitle" Text="{loc:T Lab.Input}" />
                    </DockPanel>
                    <TextBox Text="{Binding Input}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="60" MaxHeight="140" FontFamily="Menlo, Consolas, monospace" />
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="8" LineSpacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LabPreset">
                                <Button Content="{Binding Name}"
                                        Command="{Binding $parent[ItemsControl].((vm:TransformLabPageViewModel)DataContext).UsePresetCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Pipeline summary -->
            <ItemsControl ItemsSource="{Binding Stages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="0" LineSpacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StageChip">
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="Chip">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Classes="Hint" Text="{Binding Size}" />
                                    <TextBlock Classes="Hint" Text="{Binding Entropy}" />
                                    <TextBlock Classes="Hint" Text="{Binding Zeros}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="→" FontSize="22" Margin="12,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SemiColorText2}" IsVisible="{Binding HasArrow}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 1. BWT -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="CardTitle" Text="{loc:T Lab.Bwt.Title}" />
                    <TextBlock Classes="Hint" Text="{Binding RotationsCaption}" />
                    <ItemsControl ItemsSource="{Binding Rotations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:RotationRow">
                                <Border CornerRadius="4" Padding="6,1"
                                        Classes.Original="{Binding IsSentinelRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="Code" Text="{Binding Body}" />
                                        <TextBlock Classes="Code" Text="{Binding Last}" FontWeight="Bold"
                                                   Foreground="{DynamicResource SemiColorPrimary}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Styles>
                            <Style Selector="Border.Original">
                                <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
                            </Style>
                        </ItemsControl.Styles>
                    </ItemsControl>
                    <TextBlock Classes="Secondary" Text="{loc:T Lab.Bwt.Output}" />
                    <SelectableTextBlock Classes="Code" Text="{Binding BwtPreview}" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <!-- 2. MTF -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="CardTitle" Text="{loc:T Lab.Mtf.Title}" />
                    <TextBlock Classes="Secondary" Text="{loc:T Lab.Mtf.Hint}" />
                    <SelectableTextBlock Classes="Code" Text="{Binding MtfPreview}" />
                </StackPanel>
            </Border>

            <!-- 3. Zero runs -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="CardTitle" Text="{loc:T Lab.Rle.Title}" />
                    <TextBlock Classes="Secondary" Text="{loc:T Lab.Rle.Hint}" />
                    <SelectableTextBlock Classes="Code" Text="{Binding RlePreview}" />
                </StackPanel>
            </Border>

            <!-- 4. Huffman -->
            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="CardTitle" Text="{loc:T Lab.Huffman.Title}" />

                    <Grid ColumnDefinitions="200,*,170" RowDefinitions="Auto,8,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Lab.Huffman.Raw}" VerticalAlignment="Center" />
                        <ProgressBar Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding HuffmanRawShare}"
                                     Height="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="Code" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding HuffmanRawSize}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Lab.Huffman.Pipeline}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ProgressBar Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding HuffmanPipelineShare}"
                                     Height="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="Code" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Text="{Binding HuffmanPipelineSize}" />
                    </Grid>
                    <TextBlock Classes="Hint" TextWrapping="Wrap" Text="{Binding Verdict}" />

                    <Border Classes="Card" Padding="0" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding HuffmanCodes}" IsReadOnly="True" AutoGenerateColumns="False"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T Lab.Col.Symbol}" Binding="{Binding Symbol}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:T Lab.Col.Means}" Binding="{Binding Meaning}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:T Lab.Col.Count}" Binding="{Binding Count}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:T Lab.Col.Bits}" Binding="{Binding Length}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:T Lab.Col.Code}" Binding="{Binding Code}" Width="*" FontFamily="Menlo, Consolas, monospace" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
