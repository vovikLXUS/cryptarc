<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CryptArc.App.ViewModels"
             xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             x:Class="CryptArc.App.Views.NaiveVsOptimisedView"
             x:DataType="vm:NaiveVsOptimisedPageViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="PageTitle" Text="Naive vs optimised" />
            <TextBlock Classes="Secondary"
                       Text="Every optimised routine keeps its straightforward counterpart (hard rule 4). These are their Release BenchmarkDotNet results; the app does not time anything here." />
        </StackPanel>

        <Border Classes="Card" DockPanel.Dock="Top" IsVisible="{Binding !HasResults}" Padding="32">
            <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="640">
                <PathIcon Data="{StaticResource SemiIconBolt}" Width="36" Height="36" Opacity="0.5" />
                <TextBlock HorizontalAlignment="Center" Text="No benchmark results" FontWeight="SemiBold" />
                <TextBlock Classes="Secondary" TextAlignment="Center"
                           Text="Run the benchmarks in Release, copy the *.pairs.json files from BenchmarkDotNet.Artifacts/results into bench/results/, and rebuild. Looked in:" />
                <SelectableTextBlock HorizontalAlignment="Center" FontFamily="Menlo, Consolas, monospace" FontSize="12"
                                     Text="{Binding ResultsFolder}" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="230,16,*" IsVisible="{Binding HasResults}">

            <Border Grid.Column="0" Classes="Card" Padding="8" VerticalAlignment="Top">
                <ListBox ItemsSource="{Binding Suites}" SelectedItem="{Binding SelectedSuite}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SuiteItem">
                            <StackPanel Spacing="2" Margin="4,2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Classes="Hint" Text="{Binding Headline}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="2">
                <StackPanel Spacing="16">
                    <Border Classes="Card">
                        <StackPanel Spacing="6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Classes="Metric" FontSize="20"
                                           Foreground="{DynamicResource SemiColorPrimary}" Text="{Binding BestSpeedup}" />
                                <TextBlock Classes="CardTitle" VerticalAlignment="Center" Text="{Binding SelectedSuite.Title}" />
                            </DockPanel>
                            <TextBlock Classes="Secondary" Text="{Binding Story}" />
                            <Border IsVisible="{Binding IsQuickRun}" CornerRadius="6" Padding="10,6" Margin="0,4,0,0"
                                    Background="{DynamicResource SemiColorWarningLight}">
                                <TextBlock TextWrapping="Wrap"
                                           Text="These numbers come from a short or dry run. Re-run without --job short before quoting them in the report." />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Name="ChartCard" Classes="Card" Height="240">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="CardTitle" Text="Speedup over the naive version, log scale (dashed line = same speed)" />
                            <sp:AvaPlot Name="Chart" Margin="0,8,0,0" />
                        </DockPanel>
                    </Border>

                    <Border Classes="Card" Padding="0" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Case" Binding="{Binding Case}" Width="Auto" />
                                <DataGridTextColumn Header="Optimised" Binding="{Binding Method}" Width="Auto" />
                                <DataGridTextColumn Header="Naive" Binding="{Binding BaselineText}" Width="Auto" />
                                <DataGridTextColumn Header="Optimised" Binding="{Binding MeanText}" Width="Auto" />
                                <DataGridTextColumn Header="Speedup" Binding="{Binding SpeedupText}" Width="Auto" />
                                <DataGridTextColumn Header="Allocated" Binding="{Binding AllocatedText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                               Text="Times are the BenchmarkDotNet mean per operation; the naive method of each row is the [Baseline] of its group." />
                    <TextBlock Classes="Hint" TextWrapping="Wrap" Text="{Binding Machine}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
