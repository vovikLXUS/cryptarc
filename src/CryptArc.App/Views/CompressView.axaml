<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CryptArc.App.Localization"
             xmlns:vm="using:CryptArc.App.ViewModels"
             xmlns:conv="using:CryptArc.App.Converters"
             x:Class="CryptArc.App.Views.CompressView"
             x:DataType="vm:CompressPageViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="PageTitle" Text="{loc:T Compress.Title}" />
            <TextBlock Classes="Secondary"
                       Text="{loc:T Compress.Subtitle}" />
        </StackPanel>

        <Border Classes="Card" DockPanel.Dock="Top" IsVisible="{Binding !HasFile}" Padding="32">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource SemiIconLayers}" Width="36" Height="36" Opacity="0.5" />
                <TextBlock HorizontalAlignment="Center" Text="{loc:T Common.NoFileYet}" FontWeight="SemiBold" />
                <TextBlock Classes="Secondary" HorizontalAlignment="Center"
                           Text="{loc:T Common.UseChooseFile}" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="300,16,*" IsVisible="{Binding HasFile}">

            <!-- Settings -->
            <Border Grid.Column="0" Classes="Card" VerticalAlignment="Top">
                <StackPanel Spacing="16" IsEnabled="{Binding !RunCommand.IsRunning}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="Secondary" Text="{loc:T Compress.Codec}" />
                        <!-- A template rather than ToString: the "Auto" entry's name follows the language. -->
                        <ComboBox ItemsSource="{Binding CodecChoices}" SelectedItem="{Binding SelectedCodec}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CodecChoice">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="Secondary" Text="{loc:T Compress.BlockSize}" />
                        <ComboBox ItemsSource="{Binding BlockSizesKiB}" SelectedItem="{Binding SelectedBlockSizeKiB}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding Threads}" />
                            <TextBlock Classes="Secondary" Text="{loc:T Compress.Threads}" />
                        </DockPanel>
                        <Slider Minimum="1" Maximum="{Binding MaxThreads}" Value="{Binding Threads}"
                                TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Classes="Hint" TextWrapping="Wrap"
                                   Text="{loc:T Compress.Threads.Hint}" />
                    </StackPanel>

                    <CheckBox IsChecked="{Binding Verify}" Content="{loc:T Compress.Verify}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Spacing="16">

                <!-- Run and progress -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:T Compress.Cancel}" Command="{Binding RunCancelCommand}"
                                        IsVisible="{Binding RunCommand.IsRunning}" />
                                <Button Classes="Primary" Theme="{DynamicResource SolidButton}"
                                        Content="{loc:T Compress.Run}" Command="{Binding RunCommand}"
                                        IsVisible="{Binding !RunCommand.IsRunning}" />
                            </StackPanel>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="CardTitle" Text="{loc:T Compress.Blocks}" />
                                <TextBlock Classes="Hint" Text="{Binding Status}" />
                            </StackPanel>
                        </DockPanel>

                        <ProgressBar Minimum="0" Maximum="{Binding BlockTotal}" Value="{Binding BlocksDone}"
                                     Height="6" IsVisible="{Binding HasRun}" />

                        <ItemsControl ItemsSource="{Binding Tiles}" IsVisible="{Binding ShowMap}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="3" LineSpacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BlockTile">
                                    <Border Width="14" Height="14" CornerRadius="3"
                                            ToolTip.Tip="{Binding ToolTip}"
                                            BorderBrush="#D9361E" BorderThickness="{Binding !Ok, Converter={x:Static conv:BoolToThicknessConverter.Instance}}"
                                            Background="{Binding Codec, Converter={x:Static conv:CodecToBrushConverter.Instance}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="Hint" IsVisible="{Binding MapTooLarge}"
                                   Text="{loc:T Compress.MapTooLarge}" />

                        <ItemsControl ItemsSource="{Binding Usage}" IsVisible="{Binding HasResult}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="16" LineSpacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CodecUsage">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                                Background="{Binding Codec, Converter={x:Static conv:CodecToBrushConverter.Instance}}" />
                                        <TextBlock Classes="Hint" VerticalAlignment="Center">
                                            <Run Text="{Binding Name}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding Blocks}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Result of the last run -->
                <UniformGrid Columns="4" ColumnSpacing="12" IsVisible="{Binding HasResult}">
                    <Border Classes="Card">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="Secondary" Text="{loc:T Compress.Result.Compressed}" />
                            <TextBlock Classes="Metric" FontSize="20" Text="{Binding CompressedSize}" />
                            <TextBlock Classes="Hint" Text="{Binding RatioCaption}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="Card">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="Secondary" Text="{loc:T Compress.Result.Time}" />
                            <TextBlock Classes="Metric" FontSize="20" Text="{Binding Elapsed}" />
                            <TextBlock Classes="Hint" Text="{loc:T Compress.Result.WallClock}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="Card">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="Secondary" Text="{loc:T Compress.Result.Throughput}" />
                            <TextBlock Classes="Metric" FontSize="20" Text="{Binding Throughput}" />
                            <TextBlock Classes="Hint" Text="{loc:T Compress.Result.OfInput}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="Card">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="Secondary" Text="{loc:T Compress.Result.Verification}" />
                            <TextBlock Classes="Metric" FontSize="20" Text="{Binding Verification}" />
                            <TextBlock Classes="Hint" Text="{loc:T Compress.Result.RoundTrip}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- History -->
                <Border Classes="Card" Padding="0" ClipToBounds="True" IsVisible="{Binding HasResult}">
                    <StackPanel>
                        <TextBlock Classes="CardTitle" Margin="18,14,18,6" Text="{loc:T Compress.Runs}" />
                        <DataGrid ItemsSource="{Binding Runs}" IsReadOnly="True" AutoGenerateColumns="False"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T Compress.Col.Codec}" Binding="{Binding Codec}" Width="*" />
                                <DataGridTextColumn Header="{loc:T Compress.Col.Block}" Binding="{Binding BlockText}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:T Compress.Col.Threads}" Binding="{Binding Threads}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:T Compress.Col.Time}" Binding="{Binding ElapsedText}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:T Compress.Col.Ratio}" Binding="{Binding RatioText}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:T Compress.Col.Speedup}" Binding="{Binding SpeedupText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Classes="Hint" Margin="18,8,18,14" TextWrapping="Wrap"
                                   Text="{loc:T Compress.Runs.Hint}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
